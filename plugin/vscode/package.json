{
  "name": "ctxtag",
  "displayName": "Context Tag",
  "description": "C/C++ symbol analysis and navigation",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "c",
        "extensions": [
          ".c",
          ".h"
        ]
      },
      {
        "id": "cpp",
        "extensions": [
          ".cpp",
          ".hpp",
          ".cc",
          ".hh",
          ".cxx",
          ".hxx",
          ".c++",
          ".h++"
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/vscode": "^1.74.0",
    "typescript": "^5.0.0",
    "vscode-languageclient": "^9.0.1"
  },
  "license": "MIT"
}
